# Backend (Cloud Run) environment. Copy to .env, fill in, then upload as the
# repo's DOTENV secret: gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-jon-ai-investment-analyst < .env
# Never commit .env. Keep values free of inline comments.

# Comma-separated browser origins allowed to call the API (the Vercel URL in production).
CORS_ORIGINS=http://localhost:3000

# OpenRouter live AI. Leave the key empty to run in Manual AI Mode only (the route returns 501).
API_KEY=
MODEL_NAME=google/gemini-2.5-flash

# Shared rate-limit store (Upstash Redis REST). Unset = rate limiting disabled (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback limits for the "gen" bucket when the central control sheet has no row.
RATE_LIMIT_GEN_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000
